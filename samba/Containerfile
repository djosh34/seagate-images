# Fedora 44, linux/amd64.
FROM registry.fedoraproject.org/fedora:44@sha256:474e0ab5a1e59c215e59f281b1fe49f2866ec20f773533f5cca851cc830c5c2b AS build
RUN dnf -y install --setopt=install_weak_deps=False samba && dnf clean all
COPY collect.sh passwd group /
RUN bash /collect.sh /rootfs

FROM scratch
COPY --from=build /rootfs/ /
USER 2000:2000
ENTRYPOINT ["/usr/sbin/smbd", "--foreground", "--no-process-group", "--debug-stdout"]
